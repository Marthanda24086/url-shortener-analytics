# ── Required ──────────────────────────────────────────────────
# MongoDB connection string
# For local: mongodb://localhost:27017/url-shortener
# For Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/url-shortener
MONGO_URI=mongodb://localhost:27017/url-shortener

# Server
PORT=3000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────
# Generate with: node -e "console.log('sk_' + require('crypto').randomBytes(32).toString('hex'))"
MASTER_API_KEY=sk_your_super_secret_master_key_here

# Demo key for quick testing (change in production!)
DEMO_API_KEY=demo_key_12345

# Salt for IP hashing (prevents rainbow table attacks on hashed IPs)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
IP_HASH_SALT=your_random_salt_here

# ── Application ───────────────────────────────────────────────
# Base URL of your deployment (used to build short URLs)
BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated trusted IPs that bypass rate limiting (optional)
TRUSTED_IPS=127.0.0.1,::1
